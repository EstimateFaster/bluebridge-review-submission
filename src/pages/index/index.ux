        <div class="dev-row"><text class="dev-k">屏幕</text><text class="dev-v">336 × 480 / designWidth 336</text></div>
        <div class="dev-row"><text class="dev-k">框架</text><text class="dev-v">Vela 快应用</text></div>
      </div>
    </div>
  </div>
</template>

