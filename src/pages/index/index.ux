          <div class="bar"></div>
          <text class="panel-title">未来 7 天</text>
          <text class="panel-sub">周六有雨，随身带伞</text>
        </div>
        <div class="days">
          <div class="day" for="{{days}}" tid="day">
            <text class="day-name">{{$item.day}}</text>
            <image class="day-icon" src="{{$item.icon}}"></image>
            <text class="day-high">{{$item.high}}°</text>
            <text class="day-low">{{$item.low}}°</text>
          </div>
        </div>
      </div>

      <!-- 日出日落 -->
      <div class="sunrow">
        <div class="sun-item">
          <image class="sun-icon" src="/common/weather/m-sunrise.png"></image>
          <text class="sun-label">日出</text>
          <text class="sun-text">06:28</text>
        </div>
        <div class="sun-line"></div>
        <div class="sun-item sun-item-right">
          <text class="sun-text">17:26</text>
          <text class="sun-label">日落</text>
          <image class="sun-icon sun-icon-right" src="/common/weather/m-sunset.png"></image>
        </div>
      </div>
    </div>

    <!-- 开发者信息（右上角 ⋯ 打开） -->
    <div class="dev-mask" if="{{showDev}}" onclick="onCloseDev">
      <div class="dev-card" onclick="stopProp">
        <div class="dev-head">
          <text class="dev-title">开发者信息</text>
          <div class="dev-close" onclick="onCloseDev"><text class="dev-close-x">×</text></div>
        </div>
        <div class="dev-row"><text class="dev-k">包名</text><text class="dev-v">com.bluebridge.review.weather</text></div>
        <div class="dev-row"><text class="dev-k">版本</text><text class="dev-v">1.0.0 (1)</text></div>
