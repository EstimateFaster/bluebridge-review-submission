</style>

<script>
import app from '@system.app'
import router from '@system.router'
import device from '@system.device'
import vibrator from '@system.vibrator'
import prompt from '@system.prompt'

export default {
  data: {
    showDev: false,
    model: 'Vela 模拟器',
    apiLevel: '—',
    hours: [
      { time: '现在', icon: '/common/weather/w-partly.png', temp: 23 },
      { time: '15时', icon: '/common/weather/w-cloudy.png', temp: 22 },
      { time: '16时', icon: '/common/weather/w-overcast.png', temp: 21 },
      { time: '17时', icon: '/common/weather/w-rain.png', temp: 20 },
      { time: '18时', icon: '/common/weather/w-rain.png', temp: 19 }
    ],
    days: [
      { day: '今天', icon: '/common/weather/w-partly.png', high: 26, low: 17 },
      { day: '周五', icon: '/common/weather/w-cloudy.png', high: 25, low: 16 },
      { day: '周六', icon: '/common/weather/w-rain.png', high: 24, low: 15 },
      { day: '周日', icon: '/common/weather/w-clear.png', high: 26, low: 17 },
      { day: '周一', icon: '/common/weather/w-clear.png', high: 27, low: 18 },
      { day: '周二', icon: '/common/weather/w-overcast.png', high: 25, low: 16 },
      { day: '周三', icon: '/common/weather/w-rain.png', high: 24, low: 15 }
    ]
  },
  onInit() {
    try {
      device.getInfo({
        success: (info) => {
          const d = info || {}
          this.model = d.model || d.product || d.brand || 'Vela 模拟器'
          this.apiLevel = String(d.apiLevel || d.api || d.platformVersionName || '5.0')
        },
        fail: () => {}
      })
    } catch (e) {}
  },
  onExit() {
    try { vibrator.vibrate({ duration: 15 }) } catch (e) {}
    let exited = false
    try {
      if (app && typeof app.terminate === 'function') {
        app.terminate()
        exited = true
      }
    } catch (e) {}
    if (!exited) {
      try { router.back() } catch (e) {}
      try { prompt.showToast({ message: '已退出天气' }) } catch (e) {}
    }
  },
  onMore() {
    try { vibrator.vibrate({ duration: 10 }) } catch (e) {}
    this.showDev = true
  },
  onCloseDev() {
    this.showDev = false
  },
  stopProp() {}
}
</script>
